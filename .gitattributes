# Normalize source text across Windows and CI. Specific exceptions follow.
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.mts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sql text eol=lf
*.gs text eol=lf
*.webmanifest text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
.gitattributes text eol=lf
Dockerfile* text eol=lf
assets/vendor/supabase-browser-*.min.js binary
**/database.types.ts text eol=lf linguist-generated=true
**/sandbox.database.types.ts text eol=lf linguist-generated=true
**/*contracts.generated.ts text eol=lf linguist-generated=true
supabase/schema/*.catalog.json text eol=lf linguist-generated=true
# Bundled dependencies contain intentional whitespace inside generated strings.
assets/alpha-command-center.js whitespace=-blank-at-eol linguist-generated=true
.husky/* text eol=lf
