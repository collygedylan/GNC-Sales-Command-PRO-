#!/usr/bin/env sh
# v3.0.10 user-authorized fast-only commit gate. Prior slow gate is retained
# verbatim in pre-commit-legacy for deliberate manual/nightly execution.
set -eu
if [ -n "${GIT_COMMON_DIR:-}" ] && [ -f "$GIT_COMMON_DIR/hooks/pre-commit" ]; then
  common_dir=$GIT_COMMON_DIR
elif [ -n "${GIT_DIR:-}" ] && [ -f "$GIT_DIR/commondir" ]; then
  IFS= read -r relative_common < "$GIT_DIR/commondir"
  common_dir=$GIT_DIR/$relative_common
elif [ -n "${GIT_DIR:-}" ] && [ -f "$GIT_DIR/hooks/pre-commit" ]; then
  common_dir=$GIT_DIR
else
  common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
fi
exec sh "$common_dir/hooks/pre-commit" "$@"
