{
  "name": "gnc-field-app",
  "private": true,
  "version": "2026.10.10.003",
  "type": "module",
  "overrides": {
    "fast-uri": "3.1.6",
    "qs": "6.16.0",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:staged": "lint-staged --hide-all --concurrent false --diff-filter ACMRD",
    "doctor": "node scripts/tooling-doctor.mjs",
    "types:db:generate": "node scripts/database-types.mjs --generate",
    "types:db:check": "node scripts/database-types.mjs --check",
    "types:contracts:generate": "node scripts/generate-database-contracts.mjs",
    "types:contracts:check": "node scripts/generate-database-contracts.mjs --check",
    "check:db": "node scripts/database-check.mjs --staged",
    "dev:v2": "vite --config vite.v2.config.ts --host 0.0.0.0",
    "build:pilot-monitoring": "esbuild scripts/ops-precision-sentry-entry.js --bundle --format=iife --global-name=GncSentry --minify --outfile=assets/vendor/sentry-browser-10.70.0.min.js",
    "build:live:css": "tailwindcss -i assets/live-tailwind-source.css -o assets/live-tailwind-v2026082010.min.css --minify",
    "build:live:vendor": "node scripts/vendor-live-assets.mjs && esbuild scripts/live-supabase-entry.ts --bundle --format=iife --platform=browser --target=es2020 --minify --outfile=assets/vendor/supabase-browser-2.112.3.min.js",
    "build:live:schedule": "node scripts/build-production-schedule.mjs",
    "build:live:command-center": "node scripts/build-alpha-command-center.mjs",
    "build:live:assets": "npm run build:live:css && npm run build:live:vendor && npm run build:live:schedule && npm run build:live:command-center && npm run build:live:bunch-note && npm run build:live:assigned-items && npm run build:live:field-counting",
    "build:live:shell": "node scripts/build-live-shell.mjs",
    "build:live": "npm run build:live:assets && npm run build:live:shell",
    "build:v2": "tsc --noEmit -p tsconfig.json && vite build --config vite.v2.config.ts",
    "preview:v2": "vite preview --config vite.v2.config.ts --host 0.0.0.0",
    "test:v2": "vitest run --config vite.v2.config.ts",
    "test:v2:watch": "vitest --config vite.v2.config.ts",
    "test:photo": "node scripts/run-discovered-tests.mjs node-unit",
    "test:v2:e2e": "playwright test",
    "test:footer": "playwright test --config playwright.footer.config.ts",
    "test:home-roles": "playwright test --config playwright.home-role.config.ts",
    "test:foundation": "playwright test --config playwright.app-lifecycle.config.ts --workers=1",
    "check:foundation": "node scripts/check-foundation.mjs",
    "check:local": "node scripts/check-local.mjs",
    "test:season-sales-office": "playwright test --config playwright.season-sales-office.config.ts",
    "test:suspend-tag": "playwright test --config playwright.suspend-tag.config.ts",
    "test:docks-filter": "playwright test --config playwright.docks-filter.config.ts",
    "test:task-av-blanks": "playwright test --config playwright.task-av-blanks.config.ts",
    "test:session-recovery": "playwright test --config playwright.session-recovery.config.ts",
    "storybook:v2": "storybook dev -p 6006 -c v2/.storybook",
    "build:storybook:v2": "storybook build -c v2/.storybook -o v2/storybook-static",
    "lighthouse:v2": "lhci autorun --config=lighthouserc.json",
    "check:inline": "node scripts/check-inline-scripts.mjs",
    "test:select": "node scripts/select-focused-tests.mjs",
    "test:pilot": "node scripts/run-discovered-tests.mjs node-unit",
    "test:live-sync": "node scripts/run-discovered-tests.mjs node-unit",
    "migrate:auth-domain": "node scripts/migrate-native-auth-email-domain.mjs",
    "release:version": "node scripts/prepare-release-version.mjs",
    "preview:isolated": "node scripts/isolated-preview.mjs",
    "ops:diagnose": "node scripts/recovery-diagnostics.mjs",
    "ops:record": "node scripts/repair-ledger.mjs",
    "build:live:bunch-note": "node scripts/build-bunch-note.mjs",
    "build:live:assigned-items": "node scripts/build-assigned-items.mjs",
    "check:tooling": "node scripts/check-tooling-ci.mjs",
    "test:node": "node scripts/run-release-unit-checks.mjs",
    "test:node-browser": "node scripts/run-discovered-tests.mjs node-browser",
    "build:live:field-counting": "node scripts/build-field-counting.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.8.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@sentry/browser": "10.70.0",
    "@sentry/react": "10.70.0",
    "@supabase/supabase-js": "2.112.3",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "9.1.2",
    "@tanstack/react-virtual": "3.14.9",
    "dexie": "4.4.4",
    "lucide-react": "1.31.0",
    "motion": "13.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-router-dom": "7.18.2",
    "swr": "2.5.1",
    "web-vitals": "6.1.0",
    "workbox-window": "7.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@phosphor-icons/web": "2.1.2",
    "@playwright/test": "1.62.1",
    "@storybook/react-vite": "10.5.8",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "acorn": "8.18.0",
    "acorn-walk": "8.3.5",
    "deno": "2.9.6",
    "eslint": "10.12.0",
    "fabric": "6.7.1",
    "globals": "17.4.0",
    "husky": "9.1.7",
    "js-yaml": "3.15.1",
    "jsdom": "29.0.1",
    "lint-staged": "17.6.0",
    "pg": "8.23.0",
    "sharp": "0.35.4",
    "storybook": "10.5.8",
    "supabase": "2.111.0",
    "tailwindcss": "4.3.3",
    "terser": "5.50.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.71.1",
    "unpdf": "1.8.1",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
